# Repo-root local settings. Copy this file to `.env` (which is gitignored),
# fill in your values. These are read by local dev scripts (e.g. deploy:local).

# Absolute path to the packaged VS Code extension .vsix to (re)install after
# `pnpm deploy:local`. Leave unset to skip the install step entirely.
#
# When set, deploy:local runs `code --install-extension <path> --force` after
# copying the build into the root dist/, so the extension picks up the new
# build. Reload the VS Code window afterwards to view changes.
#
# The .vsix lands in dist/vscode-npm-advisor/ after `pnpm build:vscode`. If the
# exact file is missing (e.g. the version bumped), deploy:local falls back to
# the single .vsix in that directory.
#
# DEPLOY_LOCAL_VSIX_PATH=/Users/you/projects/agentic-web-learning-tool/dist/vscode-npm-advisor/vscode-npm-advisor-0.3.0.vsix
