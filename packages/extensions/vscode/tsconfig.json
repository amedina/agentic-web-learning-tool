{
  "extends": "@agentic-web-labs/shared-config/typescript/library",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vscode"],
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*", "src/**/*.tsx", "**/*.test.ts", "**/*.test.tsx"],
  "exclude": ["dist", "node_modules"]
}
