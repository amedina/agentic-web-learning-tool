# Local settings for the vscode extension (publishing + local dev). Copy this
# file to `.env` (which is gitignored), fill in your values, then run
# `pnpm apply:identity` before packaging. See PUBLISHING.md for the full
# publishing flow.

# Your Marketplace publisher id. Create one at
# https://marketplace.visualstudio.com/manage. The id is CASE-SENSITIVE and
# must match exactly (e.g. "AgenticWebLabs", not "agenticweblabs"). It becomes
# the first half of the published id (publisher.name).
VSCE_PUBLISHER=your-publisher-id

# Opt in to reinstalling the extension after `pnpm deploy:local`. Leave unset to
# skip the install step entirely. When set, deploy:local installs the NEWEST
# .vsix in the target directory via `code --install-extension <path> --force`
# after copying the build into the root dist/ (reload the VS Code window
# afterwards). The value can be the dist/vscode-npm-advisor directory or any
# .vsix path inside it — the version in the filename is ignored, so you never
# need to update this after a version bump. The .vsix lands in
# dist/vscode-npm-advisor/ after `pnpm build:vscode`.
#
# DEPLOY_LOCAL_VSIX_PATH=/Users/you/projects/agentic-web-labs/dist/vscode-npm-advisor
