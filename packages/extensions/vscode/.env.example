# Local settings for the vscode extension (publishing + local dev). Copy this
# file to `.env` (which is gitignored), fill in your values, then run
# `pnpm apply:identity` before packaging. See PUBLISHING.md for the full
# publishing flow.

# Your Marketplace publisher id. Create one at
# https://marketplace.visualstudio.com/manage. The id is CASE-SENSITIVE and
# must match exactly (e.g. "AgenticWebLabs", not "agenticweblabs"). It becomes
# the first half of the published id (publisher.name).
VSCE_PUBLISHER=your-publisher-id

# Absolute path to the packaged .vsix to (re)install after `pnpm deploy:local`.
# Leave unset to skip the install step entirely. When set, deploy:local runs
# `code --install-extension <path> --force` after copying the build into the
# root dist/, so the extension picks up the new build (reload the VS Code window
# afterwards). The .vsix lands in dist/vscode-npm-advisor/ after
# `pnpm build:vscode`; if the exact file is missing (e.g. the version bumped),
# deploy:local falls back to the single .vsix in that directory.
#
# DEPLOY_LOCAL_VSIX_PATH=/Users/you/projects/agentic-web-learning-tool/dist/vscode-npm-advisor/vscode-npm-advisor-0.3.0.vsix
